<mxfile host="app.diagrams.net">
  <diagram name="CD staging - pipeline image Gitea" id="cd-staging-gitea">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Job build -->
        <mxCell id="node-build" value="«execution environment»&#10;Job build&#10;(runner Gitea, mode docker)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="art-checkout" value="«artifact»&#10;code source&#10;(checkout)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Registre OCI -->
        <mxCell id="node-registry" value="«node»&#10;Registre OCI Gitea&#10;(git.david-legrand.fr)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="art-registry-image" value="«artifact»&#10;image&#10;api-regles:${sha}" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- cloclo / deploy -->
        <mxCell id="node-cloclo" value="«device»&#10;cloclo" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="280" height="320" as="geometry" />
        </mxCell>
        <mxCell id="node-deploy" value="«execution environment»&#10;Job deploy&#10;(runner Gitea, mode host)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="130" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="art-container" value="«artifact»&#10;conteneur api-regles&#10;(en cours d'exécution)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="890" y="280" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Flèches -->
        <mxCell id="edge-push" value="docker push" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="node-build" target="node-registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-pull" value="docker pull" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="node-registry" target="node-cloclo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-run" value="docker compose up" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node-deploy" target="art-container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note tag -->
        <mxCell id="note-tag" value="Tag = ${{ github.sha }} — un tag unique par commit, pas de tag flottant" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="420" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
