        <mxCell id="us0_crit" parent="1" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#666666;" value="Critère d&#39;acceptation : le script s&#39;exécute sans erreur, les 68 règles sont en base, vectorisées et indexées dans pgvector." vertex="1">
