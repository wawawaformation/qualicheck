          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr2" edge="1" parent="1" source="us2_card" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2F5597;fontSize=10;" target="sc2_bg">
