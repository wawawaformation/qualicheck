        <mxCell id="us1_as" parent="1" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;fontColor=#333333;" value="&lt;b&gt;En tant qu&#39;&lt;/b&gt;auditeur," vertex="1">
          <mxGeometry height="22" width="430" x="87" y="479" as="geometry" />
        </mxCell>
        <mxCell id="us1_want" parent="1" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;fontColor=#333333;" value="&lt;b&gt;je veux&lt;/b&gt; lancer un audit à partir d&#39;une URL, de pages et de règles choisies," vertex="1">
          <mxGeometry height="22" width="430" x="87" y="501" as="geometry" />
        </mxCell>
        <mxCell id="us1_so" parent="1" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;fontColor=#333333;" value="&lt;b&gt;afin d&#39;&lt;/b&gt;obtenir des constats exploitables pour démarrer mon analyse qualité." vertex="1">
          <mxGeometry height="22" width="430" x="87" y="523" as="geometry" />
        </mxCell>
        <mxCell id="us1_crit" parent="1" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#666666;" value="Critère d&#39;acceptation : les constats sont générés, stockés et consultables pour chaque règle sélectionnée sur chaque page auditée." vertex="1">
