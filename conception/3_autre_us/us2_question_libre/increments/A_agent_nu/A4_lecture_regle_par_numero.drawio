        <mxCell id="note_a2" value="A2 : chaque appel d'outil, quel qu'il soit, émet un span (durée, résultat, nom de l'outil : rechercher_regles ou lire_regle). Voir A2_instrumentation.drawio." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="480" height="70" as="geometry" /></mxCell>
        <mxCell id="start" value="Question reçue (POST /questions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="llm" value="&lt;b&gt;LLM (le modèle)&lt;/b&gt;&lt;br&gt;choisit l'outil à appeler,&lt;br&gt;lit chaque résultat,&lt;br&gt;puis répond" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="final" value="Réponse finale : texte + règles citées + trace_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="cont" value="Outils de l'agent" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="300" height="310" as="geometry" /></mxCell>
        <mxCell id="tool_search" value="rechercher_regles(mots_cles)&lt;br&gt;recherche par mots-clés (A1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cont"><mxGeometry x="0" y="30" width="300" height="140" as="geometry" /></mxCell>
        <mxCell id="tool_lire" value="&lt;b&gt;lire_regle(numero)&lt;/b&gt;&lt;br&gt;NOUVEL outil (A4) : règle complète" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="cont"><mxGeometry x="0" y="170" width="300" height="140" as="geometry" /></mxCell>
        <mxCell id="api1" value="GET /regles?q=..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="225" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="api2" value="GET /regles/{numero}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="365" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="res_search" value="Liste de règles (10 au plus)&lt;br&gt;solution coupée à 300 caractères&lt;br&gt;&lt;b&gt;NOUVEAU : solution_tronquee&lt;/b&gt; (vrai / faux) sur chaque règle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="195" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="reponse_api" value="Réponse de l'API ?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="440" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="ok" value="Règle complète&lt;br&gt;13 champs, sans troncature" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="640" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="ko404" value="404 : l'agent reçoit&lt;br&gt;{statut: 404,&lt;br&gt;erreur: « Règle N inconnue »}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="640" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="ko5xx" value="Panne : l'agent reçoit&lt;br&gt;{statut: 5xx de l'API,&lt;br&gt;ou 503 si aucune réponse}&lt;br&gt;jamais une exception" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1440" y="640" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="note_2e" value="2e chemin vers la lecture : une règle marquée solution_tronquee dans la liste renvoyée au LLM peut être lue en entier ensuite par lire_regle." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="510" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="retour" value="Résultat renvoyé au LLM : il reprend la main (nouvel appel d'outil, ou réponse finale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="790" width="1260" height="60" as="geometry" /></mxCell>
