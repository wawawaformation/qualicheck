        <mxCell id="title" value="A4 - lire une règle par son numéro : le LLM choisit parmi ses outils" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry" /></mxCell>
