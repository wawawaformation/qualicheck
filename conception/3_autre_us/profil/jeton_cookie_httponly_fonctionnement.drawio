<mxfile host="app.diagrams.net">
  <diagram name="Fonctionnement normal - jeton en cookie HttpOnly" id="jeton-cookie-httponly-fonctionnement">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titre" value="Fonctionnement normal — jeton en cookie HttpOnly" style="text;html=1;align=center;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="580" height="30" as="geometry" />
        </mxCell>

        <!-- Acteurs -->
        <mxCell id="actor-client" value="Client (Vue.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="actor-cookie" value="Navigateur&#10;(gestion des cookies)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="actor-api" value="API api_business" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Lignes de vie -->
        <mxCell id="lv-client" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="120" as="sourcePoint" />
            <mxPoint x="170" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lv-cookie" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="120" as="sourcePoint" />
            <mxPoint x="460" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lv-api" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="120" as="sourcePoint" />
            <mxPoint x="750" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Connexion -->
        <mxCell id="msg1" value="1. POST /connexion (identifiants)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="160" as="sourcePoint" />
            <mxPoint x="750" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg2" value="2. Set-Cookie: jeton=...; HttpOnly" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="220" as="sourcePoint" />
            <mxPoint x="460" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg3" value="3. stocke le cookie&#10;(le JS du client ne voit jamais passer cette étape)" style="html=1;endArrow=none;dashed=1;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="280" as="sourcePoint" />
            <mxPoint x="460" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="sep" value="plus tard, à chaque appel API" style="text;html=1;align=center;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="260" y="330" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- Appel API -->
        <mxCell id="msg4" value="4. GET /... (le code JS du client ne touche jamais au jeton)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="400" as="sourcePoint" />
            <mxPoint x="460" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg5" value="5. ajoute automatiquement le cookie à la requête" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="460" as="sourcePoint" />
            <mxPoint x="750" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="Le navigateur gère le cookie tout seul, à aucun moment le code JS n'y a accès — un script injecté n'a donc rien à lire." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="510" width="500" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
