<mxfile host="app.diagrams.net">
  <diagram name="Fonctionnement normal - jeton en localStorage" id="jeton-localstorage-fonctionnement">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titre" value="Fonctionnement normal — jeton en localStorage" style="text;html=1;align=center;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="540" height="30" as="geometry" />
        </mxCell>

        <!-- Acteurs -->
        <mxCell id="actor-client" value="Client (Vue.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="actor-storage" value="localStorage&#10;(accessible à tout JS de la page)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="actor-api" value="API api_business" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Lignes de vie -->
        <mxCell id="lv-client" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="120" as="sourcePoint" />
            <mxPoint x="170" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lv-storage" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="120" as="sourcePoint" />
            <mxPoint x="460" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lv-api" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="120" as="sourcePoint" />
            <mxPoint x="750" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Connexion -->
        <mxCell id="msg1" value="1. POST /connexion (identifiants)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="160" as="sourcePoint" />
            <mxPoint x="750" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg2" value="2. jeton" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="220" as="sourcePoint" />
            <mxPoint x="170" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg3" value="3. localStorage.setItem('jeton', ...)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="280" as="sourcePoint" />
            <mxPoint x="460" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="sep" value="plus tard, à chaque appel API" style="text;html=1;align=center;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="260" y="330" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- Appel API -->
        <mxCell id="msg4" value="4. localStorage.getItem('jeton')" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="380" as="sourcePoint" />
            <mxPoint x="460" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg5" value="5. jeton (valeur en clair)" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="430" as="sourcePoint" />
            <mxPoint x="170" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg6" value="6. GET /... — en-tête Authorization: Bearer JETON&#10;(ajouté explicitement par le code JS du client)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="490" as="sourcePoint" />
            <mxPoint x="750" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="Le code JS du client lit lui-même le jeton et le pose dans l'en-tête — donc n'importe quel autre script JS qui tourne dans la page peut faire pareil." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="200" y="530" width="500" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
