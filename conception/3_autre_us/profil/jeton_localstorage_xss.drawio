<mxfile host="app.diagrams.net">
  <diagram name="Jeton en localStorage face a une XSS" id="jeton-localstorage-xss">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titre -->
        <mxCell id="titre" value="Jeton stocké en localStorage — une XSS suffit à le voler" style="text;html=1;align=center;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="540" height="30" as="geometry" />
        </mxCell>

        <!-- Acteurs -->
        <mxCell id="actor-script" value="Script injecté (XSS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="actor-storage" value="localStorage&#10;(accessible à tout JS de la page)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="actor-attaquant" value="Serveur de l'attaquant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Lignes de vie -->
        <mxCell id="lv-script" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="120" as="sourcePoint" />
            <mxPoint x="170" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lv-storage" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="120" as="sourcePoint" />
            <mxPoint x="460" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lv-attaquant" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="120" as="sourcePoint" />
            <mxPoint x="750" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Messages -->
        <mxCell id="msg1" value="1. localStorage.getItem('jeton')" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="180" as="sourcePoint" />
            <mxPoint x="460" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg2" value="2. jeton (valeur en clair)" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="250" as="sourcePoint" />
            <mxPoint x="170" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg3" value="3. envoyer le jeton (fetch/beacon)" style="html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="330" as="sourcePoint" />
            <mxPoint x="750" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Résultat -->
        <mxCell id="resultat" value="⚠ Jeton volé — l'attaquant peut usurper l'utilisateur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="260" y="410" width="380" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
