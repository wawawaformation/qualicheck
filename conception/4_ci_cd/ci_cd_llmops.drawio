        <mxCell id="note_revue" value="Idée non actée : revue automatisée&#10;additionnelle via Claude Code&#10;GitHub Action (backend Azure AI&#10;Foundry, payé par la formation)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="260" height="110" as="geometry" />
        </mxCell>

