# URL de app/api_regles lues par src/apiServer.js.
# Aucun secret ici : la clé API se saisit dans l'application (localStorage).
# Dev : npm run dev pointe vers l'API locale.
VITE_API_REGLES_URL_DEV=http://localhost:8880/
# Préprod : définir avant un npm run build de déploiement.
VITE_API_REGLES_URL_PREPROD=https://regles.qualicheck.koabana.fr/
