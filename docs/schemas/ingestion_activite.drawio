        </mxCell>

        <mxCell id="end_fail" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane_pipeline">
          <mxGeometry x="70" y="570" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end_failc" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane_pipeline">
          <mxGeometry x="77" y="577" width="16" height="16" as="geometry" />
        </mxCell>

        <mxCell id="summary" value="Résumé : tokens entrée/sortie,&#10;coût estimé" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="lane_pipeline">
          <mxGeometry x="140" y="500" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="show_summary" value="Voit le résumé en console" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="45" y="590" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="end_ok" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane_user">
          <mxGeometry x="110" y="660" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end_okc" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane_user">
          <mxGeometry x="117" y="667" width="16" height="16" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="start" target="run"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="run" target="check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="oui" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="check" target="ask_prompt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="non" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="check" target="etape1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="ask_prompt" target="choice_user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="choice_user" target="branch1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="m" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="branch1" target="msg_update"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="msg_update" target="end1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="n" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="branch1" target="ask_confirm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="ask_confirm" target="choice_confirm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="choice_confirm" target="branch2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="N / refus" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="branch2" target="msg_cancel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="msg_cancel" target="end2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="y" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="branch2" target="clear"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="clear" target="etape1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="etape1" target="etape2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="etape2" target="etape3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="etape3" target="etape4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="à chaque étape" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="etape4" target="err_check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" value="oui" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="err_check" target="fail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="fail" target="end_fail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22" value="non" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="err_check" target="summary"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="summary" target="show_summary"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="show_summary" target="end_ok"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
