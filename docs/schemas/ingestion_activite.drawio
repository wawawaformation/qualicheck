<mxfile host="app.diagrams.net">
  <diagram name="Activité make ingestion" id="ingestion-activite">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pool" value="Diagramme d'activité — make ingestion" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="900" height="900" as="geometry" />
        </mxCell>

        <mxCell id="lane_user" value="Utilisateur" style="swimlane;horizontal=1;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5f5f5;" vertex="1" parent="pool">
          <mxGeometry x="0" y="30" width="270" height="870" as="geometry" />
        </mxCell>

        <mxCell id="lane_script" value="scripts/ingestion.py" style="swimlane;horizontal=1;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;" vertex="1" parent="pool">
          <mxGeometry x="270" y="30" width="330" height="870" as="geometry" />
        </mxCell>

        <mxCell id="lane_pipeline" value="Pipeline (Étapes 1-4)" style="swimlane;horizontal=1;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;" vertex="1" parent="pool">
          <mxGeometry x="600" y="30" width="300" height="870" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane_user">
          <mxGeometry x="110" y="20" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="run" value="Lance make ingestion&#10;[LIMIT=n optionnel]" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="45" y="80" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="check" value="regle contient&#10;des lignes ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lane_script">
          <mxGeometry x="90" y="80" width="120" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ask_prompt" value="Affiche le prompt&#10;nouvelle [n] / mise à jour [m]" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_script">
          <mxGeometry x="70" y="180" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="choice_user" value="Choisit n ou m" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="45" y="185" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="branch1" value="" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lane_script">
          <mxGeometry x="130" y="260" width="50" height="50" as="geometry" />
        </mxCell>

        <mxCell id="msg_update" value="Affiche : mise à jour&#10;pas encore implémentée&#10;(hors MVP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lane_script">
          <mxGeometry x="30" y="330" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="end1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane_script">
          <mxGeometry x="80" y="410" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end1c" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane_script">
          <mxGeometry x="87" y="417" width="16" height="16" as="geometry" />
        </mxCell>

        <mxCell id="ask_confirm" value="Demande confirmation&#10;suppression [y/N]" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_script">
          <mxGeometry x="190" y="330" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="choice_confirm" value="Répond y ou N" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="45" y="335" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="branch2" value="" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lane_script">
          <mxGeometry x="250" y="410" width="50" height="50" as="geometry" />
        </mxCell>

        <mxCell id="msg_cancel" value="Suppression annulée,&#10;arrêt du script" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lane_script">
          <mxGeometry x="150" y="490" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="end2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lane_script">
          <mxGeometry x="200" y="560" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end2c" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane_script">
          <mxGeometry x="207" y="567" width="16" height="16" as="geometry" />
        </mxCell>

        <mxCell id="clear" value="clear_opquast_tables()&#10;TRUNCATE ... CASCADE" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_script">
          <mxGeometry x="230" y="270" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="etape1" value="Étape 1 — Acquisition&#10;(API + scraping,&#10;tronqué si --limit)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_pipeline">
          <mxGeometry x="70" y="80" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="etape2" value="Étape 2 — Agrégation" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_pipeline">
          <mxGeometry x="70" y="160" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="etape3" value="Étape 3 — Enrichissement&#10;(LLM Kimi K2.6, par règle)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_pipeline">
          <mxGeometry x="70" y="240" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="etape4" value="Étape 4 — Stockage&#10;(upsert PostgreSQL)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_pipeline">
          <mxGeometry x="70" y="320" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="err_check" value="Erreur sur&#10;l'étape ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lane_pipeline">
          <mxGeometry x="90" y="400" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="fail" value="Log erreur&#10;(console + fichier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lane_pipeline">
