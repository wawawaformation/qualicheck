# Connexion PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Base de test dédiée aux tests d'intégration destructeurs — jamais
# POSTGRES_DB (voir CLAUDE.md, incident du 2026-07-25)
POSTGRES_TEST_DB=

# Base du domaine audit (scission du 2026-09-08). La base nommée par
# POSTGRES_DB reste celle du référentiel Opquast.
POSTGRES_DB_AUDIT=qualicheck_audit
POSTGRES_TEST_DB_AUDIT=qualicheck_audit_test

# Opquast API (ingestion.md)
OPQUAST_API_BASE_URL=https://api.opquast.com/checklist/public/
OPQUAST_SITE_BASE_URL=https://checklists.opquast.com/fr/qualite-numerique/

# LLM — Azure
AZURE_AI_ENDPOINT=...
AZURE_AI_API_KEY=...

AZURE_MODEL_KIMI=...                    # nom de déploiement Azure — rôle résolu via app/ingestion/manifest.yml
AZURE_MODEL_GPT=...                     # gpt-5.4
AZURE_MODEL_GPT_MINI=...                # gpt-5.4-mini
AZURE_MODEL_GPT_NANO=...                # gpt-5.4-nano
AZURE_MODEL_TEXT_EMBEDDING_SMALL=...    # rôle embedding — résolu via app/ingestion/manifest.yml
AZURE_MODEL_DEEPSEEK_FLASH=...          # DeepSeek-V4-Flash — candidat agent US2 A1, à comparer au même modèle via Ollama Cloud

# LLM — Infomaniak (cible future, cf. CLAUDE.md)
INFOMANIAK_API_KEY=...
INFOMANIAK_PRODUCT_ID=...
INFOMANIAK_ENDPOINT=...
INFOMANIAK_MODEL_APERTUS=...
INFOMANIAK_MODEL_MINILM=...    # disqualifié (max_token_input=128), conservé pour référence — cf. CLAUDE.md

# LLM — Ollama Cloud (fallback historique, testé aussi comme candidat agent US2 A1)
OLLAMA_API_KEY=...
OLLAMA_ENDPOINT=...    # https://ollama.com/v1 — pas api.ollama.com (404 silencieux avec ChatOpenAI)
OLLAMA_MODEL_DEEPSEEK_FLASH=...    # deepseek-v4-flash:cloud — tool-calling natif validé
OLLAMA_MODEL_DEEPSEEK_PRO=...      # deepseek-v4-pro:cloud — tool-calling natif validé

# API règles (app/api_regles/)
# Port et URL de développement : voir app/api_regles/manifest.yml (déductibles)
API_REGLES_URL_DEV=http://localhost:8880    # URL réellement appelée par l'agent US2 dans CET environnement — API_REGLES_URL_PREPROD (ou équivalent staging) en déploiement
API_REGLES_URL_PREPROD=https://regles.qualicheck.koabana.fr
API_REGLES_TOKEN_DEV=    # secret : token Bearer du client "dev" (voir clients: dans manifest.yml)
API_REGLES_TOKEN_ELIE=       # secret : token Bearer du client "elie-sloim"
API_REGLES_TOKEN_DAVID=      # secret : token Bearer du client "david-legrand"
API_REGLES_TOKEN_FORMATEUR=  # secret : token Bearer du client "formateur"

# API business (app/api_business/, partagée US1/US2 — à concevoir)
API_BUSINESS_URL_DEV=http://localhost:8882
API_BUSINESS_URL_PREPROD=https://api.qualicheck.koabana.fr
# API_BUSINESS_TOKEN_* : authentification à définir dans les cartes suivantes (pas de valeur pour l'instant)

# Observabilité — traces OpenTelemetry (increment A2)
APP_ENV=dev    # environnement porté par les traces (attribut OTel deployment.environment.name) : dev, staging, prod... les tests forcent test via tests/conftest.py
OTEL_EXPORTER=jsonl    # jsonl (défaut, fichier local) ou otlp (export vers Langfuse Cloud)
OTEL_JSONL_PATH=logs/traces.jsonl    # mode jsonl uniquement — un span par ligne
# Trio requis uniquement en mode OTEL_EXPORTER=otlp (sinon ignoré)
LANGFUSE_PUBLIC_KEY=...    # secret : clé publique du projet Langfuse Cloud
LANGFUSE_SECRET_KEY=...    # secret : clé secrète du projet Langfuse Cloud
LANGFUSE_BASE_URL=https://cloud.langfuse.com
