# Secrets — jamais versionnés
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Logs d'exécution des scripts
logs/*.log

# Éditeurs
.idea/
.vscode/
*.swp
*.swo
.~lock.*#

# Fichiers de backup draw.io
*.drawio.bkp
.*.drawio.bkp
.*.drawio.dtmp
.$*.dtmp

# Matériel de travail temporaire (brainstorm, analyses brutes)
tmp/

# Dumps SQL (make export_sql) — grossissent et changent à chaque export
backups/

# Config locale Claude Code — peut contenir des secrets dans l'historique
# des permissions (ex. clé API collée dans une commande curl autorisée)
.claude/
